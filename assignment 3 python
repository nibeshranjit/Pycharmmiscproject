#Write a Python function to remove all occurrences of a specified value from a list.
#Input: [1, 2, 3, 4, 5, 3], Value=3
#Output: [1, 2, 4, 5]

nums = [1, 2, 3, 4, 5, 3]
val = 3
result = []

for i in nums:
    if i != val:
        result.append(i)

print(result)

